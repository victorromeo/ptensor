#ifndef PTENSOR_CONFIG_H
#define PTENSOR_CONFIG_H
/* Generated by CMake from ptensor_config.h.in. Do not edit. */

/* 1 if the int8 TFLM-compatible quantized operators are built in. */
#cmakedefine01 PTENSOR_WITH_QUANTIZED_OPS
/* 1 if SimpleErrorHandler is built in. */
#cmakedefine01 PTENSOR_WITH_SIMPLE_ERROR_HANDLER

/* 1 if operators use pointer-based fast paths on dense tensors. Turning it
 * off keeps only the reference loops (smaller code, much slower). */
#cmakedefine01 PTENSOR_WITH_FAST_KERNELS

/* 1 if HoughRomTensor (Hough line-codebook weight storage) is built in. */
#cmakedefine01 PTENSOR_WITH_HOUGH

#endif
